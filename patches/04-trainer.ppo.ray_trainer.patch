+    @staticmethod
+    def _extract_reward_log_jsons(reward_extra_infos_dict: dict[str, Any]) -> list[str]:
+        reward_logs = reward_extra_infos_dict.get("reward_log_json")
+        if reward_logs is None:
+            return []
+
+        extracted_logs = []
+
+        def _collect_strings(value: Any) -> None:
+            if value is None:
+                return
+            if isinstance(value, np.ndarray):
+                _collect_strings(value.tolist())
+                return
+            if isinstance(value, (list, tuple)):
+                for item in value:
+                    _collect_strings(item)
+                return
+            if isinstance(value, str) and value:
+                extracted_logs.append(value)
+
+        _collect_strings(reward_logs)
+        return extracted_logs
+
+    def _get_reward_batch_log_dir(self) -> str:
+        base_output_dir = os.environ.get("OUTPUTS") or os.environ.get("OUTPUT_DIR")
+        if base_output_dir:
+            dir_path = os.path.join(base_output_dir, "proposal_gen", "logs")
+        else:
+            dir_path = "/mnt/my_output/proposal_gen/latest_results"
+        os.makedirs(dir_path, exist_ok=True)
