+                    base_output_dir = os.environ.get("OUTPUTS") or os.environ.get("OUTPUT_DIR")
+                    metadata_log_path = metadata.get("log_path")
+                    if metadata_log_path:
+                        if os.path.isabs(metadata_log_path):
+                            log_path = metadata_log_path
+                        elif base_output_dir:
+                            log_path = os.path.join(base_output_dir, metadata_log_path)
+                        else:
+                            log_path = os.path.join("proposal_gen", "logs", os.path.basename(metadata_log_path))
+            except (json.JSONDecodeError, OSError):
