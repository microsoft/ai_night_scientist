+    def _build_reward_batch_log_rows(
+        self, batch: DataProto, reward_extra_infos_dict: dict[str, Any]
+    ) -> list[dict[str, Any]]:
+        reward_logs = self._extract_reward_log_jsons(reward_extra_infos_dict)
+        if not reward_logs:
+            return []
+
+        extra_infos = batch.non_tensor_batch.get("extra_info")
+        award_ids = []
+        if extra_infos is not None:
+            iterable_extra_infos = extra_infos.tolist() if isinstance(extra_infos, np.ndarray) else extra_infos
+            if not isinstance(iterable_extra_infos, (list, tuple)):
+                iterable_extra_infos = [iterable_extra_infos]
+            for extra_info in iterable_extra_infos:
+                if isinstance(extra_info, dict) and extra_info.get("award_id") is not None:
+                    award_ids.append(str(extra_info["award_id"]))
+                else:
+                    award_ids.append("")
+
+        if not award_ids or all(not award_id for award_id in award_ids):
+            uid_values = batch.non_tensor_batch.get("uid")
+            if uid_values is not None:
+                award_ids = uid_values.tolist() if isinstance(uid_values, np.ndarray) else list(uid_values)
+                award_ids = [str(uid_value) for uid_value in award_ids]
+
+        rollout_counts: dict[str, int] = defaultdict(int)
+        rows = []
+        for sample_idx, reward_log in enumerate(reward_logs):
+            try:
+                row = json.loads(reward_log)
+            except json.JSONDecodeError:
+                row = {"raw_reward_log_json": reward_log}
+
+            award_id = award_ids[sample_idx] if sample_idx < len(award_ids) and award_ids[sample_idx] else f"sample_{sample_idx}"
+            rollout_id = rollout_counts[award_id]
+            rollout_counts[award_id] += 1
+
+            row["step"] = self.global_steps
+            row["award_id"] = award_id
+            row["rollout_id"] = rollout_id
+            rows.append(row)
+
+        return rows
+
+    @staticmethod
+    def _flatten_reward_values(value: Any) -> list[float]:
+        if value is None:
+            return []
+        if isinstance(value, np.ndarray):
+            return RayPPOTrainer._flatten_reward_values(value.tolist())
+        if isinstance(value, (list, tuple)):
+            flattened = []
+            for item in value:
+                flattened.extend(RayPPOTrainer._flatten_reward_values(item))
+            return flattened
+        if isinstance(value, (int, float, np.integer, np.floating)) and not isinstance(value, bool):
+            return [float(value)]
+        return []
+
+    def _log_reward_components_to_wandb(self, logger, reward_extra_infos_dict: dict[str, Any]) -> None:
+        if "wandb" not in logger.logger:
+            return
+
+        reward_logs = self._extract_reward_log_jsons(reward_extra_infos_dict)
+        if not reward_logs:
+            return
+
+        parsed_logs = []
+        for reward_log in reward_logs:
+            try:
+                parsed_logs.append(json.loads(reward_log))
+            except json.JSONDecodeError:
+                continue
+
+        if not parsed_logs:
+            return
+
+        wandb = logger.logger["wandb"]
+        wandb_metrics = {}
+        scalar_fields = [
+            "action_level_entropy",
+            "action_level_similarity",
+            "action_level_score",
+            "process_level_num_intermediate",
+            "process_level_score",
+            "outcome_level_feasibility",
+            "outcome_level_score",
+            "final_score",
+        ]
+        list_fields = [
+            "action_level_raw_entropies",
+            "action_level_raw_similarities",
+            "process_level_novelty",
+            "process_level_relevance",
+        ]
+
+        for field in scalar_fields:
+            values = []
+            for entry in parsed_logs:
+                values.extend(self._flatten_reward_values(entry.get(field)))
+            if values:
+                wandb_metrics[f"reward_components/{field}"] = float(np.mean(values))
+
+        for field in list_fields:
+            values = []
+            for entry in parsed_logs:
+                values.extend(self._flatten_reward_values(entry.get(field)))
+            if values:
+                wandb_metrics[f"reward_components/{field}"] = float(np.mean(values))
+                wandb_metrics[f"reward_components/{field}_hist"] = wandb.Histogram(np.array(values, dtype=float))
+
+        if wandb_metrics:
+            logger.log(data=wandb_metrics, step=self.global_steps, backend=["wandb"])
+
+    def _append_reward_batch_log(self, batch: DataProto, reward_extra_infos_dict: dict[str, Any]) -> None:
+        rows = self._build_reward_batch_log_rows(batch, reward_extra_infos_dict)
+        if not rows:
+            return
+
+        log_path = self._resolve_reward_batch_log_path()
+        # JSONL keeps writes append-only, so log cost stays proportional to the current batch
+        # instead of growing with the total history size.
+        with open(log_path, "a", encoding="utf-8") as log_file:
+            for row in rows:
+                log_file.write(json.dumps(row, ensure_ascii=False))
+                log_file.write("\n")
+
