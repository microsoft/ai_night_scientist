+            if run_suffix != "manual":
+                date_part, separator, time_part = run_suffix.partition("_")
+                if separator and len(date_part) == 8 and date_part.isdigit() and len(time_part) >= 6:
+                    short_run_suffix = f"{date_part[4:]}_{time_part[:6]}"
+                elif len(run_suffix) > 11:
+                    short_run_suffix = run_suffix[-11:]
+
+            experiment_name = str(self.config.trainer.experiment_name or "proposal_gen")
+            experiment_name = experiment_name.replace(os.sep, "_").replace(" ", "_")
+            log_filename = f"{experiment_name}_{short_run_suffix}.jsonl"
+            log_path = os.path.join(self._get_reward_batch_log_dir(), log_filename)
+            base_output_dir = os.environ.get("OUTPUTS") or os.environ.get("OUTPUT_DIR")
+            metadata_log_path = os.path.relpath(log_path, base_output_dir) if base_output_dir else log_path
+            with open(metadata_path, "w", encoding="utf-8") as metadata_file:
