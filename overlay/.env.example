# ---------------------------------------------------------------------------
# Night Science — environment configuration
#
#   cp .env.example .env     then fill in the values and:  set -a; . ./.env; set +a
#
# Nothing in this repository hardcodes an endpoint, key, or account. Every
# deployment-specific value lives here. `.env` is gitignored; `.env.example`
# must never contain a real credential.
# ---------------------------------------------------------------------------

# === LLM judge (required for training) =====================================
# The reward decomposes each proposal into atomic ideas and scores novelty,
# feasibility and relevance with an LLM judge. Comma-separate several Azure
# OpenAI endpoints to spread load; requests are round-robined across them.
CREATIVE_AZURE_ENDPOINTS=https://<your-resource>.cognitiveservices.azure.com
CREATIVE_AZURE_MODELS=gpt-4.1
CREATIVE_AZURE_API_VERSION=2024-12-01-preview
CREATIVE_AZURE_RPM=5000

# Authenticate one of three ways — pick exactly one:
#   1. Managed identity / `az login`  — set neither variable below (default)
#   2. Keys inline                    — CREATIVE_AZURE_API_KEYS, comma-separated
#   3. Keys via other env vars        — CREATIVE_AZURE_API_KEY_ENV_VARS names them
# CREATIVE_AZURE_API_KEYS=<key1>,<key2>
# CREATIVE_AZURE_API_KEY_ENV_VARS=AZURE_KEY_1,AZURE_KEY_2

# Optional: an OpenAI-compatible HTTP proxy instead of calling Azure directly.
# CREATIVE_LLM_SINGLE_URL=https://<your-proxy>/access/llm/
# CREATIVE_LLM_BATCH_URL=https://<your-proxy>/access/llm/batch/

# === arXiv retrieval =======================================================
# Where the `search` action sends queries. Must be serving before training
# starts: a dead retriever returns empty results instead of failing, and the
# model learns that searching is worthless.
# Served by the companion repo (see README). Must be answering before training.
CREATIVE_RETRIEVER_URL=http://127.0.0.1:8000/retrieve

# === Output locations ======================================================
OUTPUTS=./output_dir
# Groups all logs from one run. Leave unset and launch.sh generates it.
# PROPOSAL_GEN_RUN_TIMESTAMP=

# === Ray (multi-node only) =================================================
RAY_ADDRESS=http://127.0.0.1:8265

# === Third-party accounts ==================================================
# Weights & Biases, if trainer.logger includes wandb.
# WANDB_API_KEY=<your-wandb-key>
# Hugging Face, for gated models or datasets.
# HF_TOKEN=<your-hf-token>
